# Vercel AI Gateway. Get one at https://vercel.com/dashboard -> AI Gateway -> API keys.
# Every step of the playground works without this; only the two "live generation"
# steps (09 and 10) need it.
AI_GATEWAY_API_KEY=

# Any model slug the gateway routes to. Defaults to this if unset.
PLAYGROUND_MODEL=anthropic/claude-sonnet-4.5
